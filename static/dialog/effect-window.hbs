<section class="effect-window">
	<div class="modifiers">
		{{#each modifiers}}
			<label
				class="grid col-subgrid col-span-4 align-center pointer"
				data-action="toggleModifier"
				data-path="{{ path }}"
				data-index="{{ index }}"
			>
				<span class="text-right">{{~warden-prettify-modifier value prefix postfix ~}}</span>
				<span>{{ label }}</span>
				{{#if pretty_type}}
					<span class="text-center" title='{{localize (concat "warden.modifier_type." pretty_type)}}'>
						{{localize (concat "warden.modifier_type_abbr." pretty_type)}}
					</span>
				{{else}}
					<span class="text-center" title='{{localize (concat "warden.modifier_type." modifier_type)}}'>
						{{localize (concat "warden.modifier_type_abbr." modifier_type)}}
					</span>
				{{/if}}
				<input
					class="grid place-center"
					type="checkbox"
					{{checked enabled}}
				/>
			</label>
		{{/each}}
		<hr class="col-span-4" />
		<form class="add-modifier-form grid col-subgrid col-span-4">
			<input class="text-right" type="number" name="value" value="{{ pending_effect.value }}" />
			<input
				type="text"
				name="label"
				value="{{ pending_effect.label }}"
				placeholder="{{localize 'warden.modifier_label'}}"
			/>
			<select name="modifier_type">
				{{selectOptions
					choices
					selected=pending_effect.modifier_type
					localize=true
				}}
			</select>
			<button type="submit"><i class="fa-solid fa-plus"></i></button>
		</form>
	</div>

	<button class="col-span-4" data-action="execute">{{localize "warden.roll.effect_submit"}} {{ formula }}</button>
</section>
